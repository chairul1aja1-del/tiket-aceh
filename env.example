# Salin file ini menjadi .env untuk pengembangan lokal (jangan di-commit).
# Di hosting (Render, Railway, dll) isi nilai-nilai ini lewat menu Environment.

# Wajib: alamat database PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/aceh_pass

# Isi true bila database memerlukan SSL (umum pada hosting cloud)
DATABASE_SSL=false

# Wajib: sandi login (minimal 8 karakter). Nama pengguna petugas: "petugas".
# Panitia: nama pengguna bebas + sandi admin.
ADMIN_PASSWORD=
PETUGAS_PASSWORD=

# Opsional
PORT=3000
# Daftar alamat web yang boleh memanggil API dari domain lain, dipisah koma.
# Kosongkan bila web disajikan oleh server ini sendiri. Contoh: https://nama.github.io
ALLOWED_ORIGINS=
# 1 bila berada di belakang proxy/hosting (membaca IP asli dari X-Forwarded-For)
TRUST_PROXY=1
# 0 untuk mematikan pembuatan tabel otomatis saat server mulai
AUTO_MIGRATE=1
